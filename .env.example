# ---------------------------------------------------------------------------
# AXISMCP portal — environment template
# Copy to .env.local for development. Set the same keys in your host dashboard
# for production (never commit .env.local — it is gitignored).
# ---------------------------------------------------------------------------

# Public Supabase project (safe to expose; authorization is RLS, not secrecy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose the service_role key to this app. It bypasses RLS entirely.
# SUPABASE_SERVICE_ROLE_KEY=   # <-- do NOT add this here

# AXISMCP API backend
# API_BASE is server-only (preferred). NEXT_PUBLIC_API_BASE is the legacy
# fallback and is also used for the Content-Security-Policy connect-src.
API_BASE=https://api.handlebid.lol
NEXT_PUBLIC_API_BASE=https://api.handlebid.lol

# Canonical public origin — used for CSS/SEO metadata, the CSP allow-list, and
# same-origin (anti-CSRF) checks on /api/auth/*. Set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared rate-limit counters (recommended in production).
# Without these, limits are per instance and reset on redeploy.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional build escape hatch (do not use in production):
# SKIP_ENV_VALIDATION=1

# ---------------------------------------------------------------------------
# Supabase Auth dashboard checklist (required for sign-in to work):
#   Authentication → URL Configuration
#     Site URL:      https://your-domain.com
#     Redirect URLs: https://your-domain.com/auth/callback
#                    http://localhost:3000/auth/callback
# ---------------------------------------------------------------------------
